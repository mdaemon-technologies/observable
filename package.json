{
  "name": "@mdaemon/observable",
  "version": "3.1.2",
  "type": "module",
  "description": "A function for creating an observable object, array, boolean, string, or number.",
  "main": "dist/observable.umd.js",
  "module": "dist/observable.mjs",
  "browser": "dist/observable.umd.js",
  "common": "dist/observable.cjs",
  "typings": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.config.dist.ts",
    "test:smoke": "node test/smoke.cjs",
    "dev-test": "vitest",
    "test:types": "node test/consumer-types.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.test.json",
    "build": "vite build && node node_modules/typescript/bin/tsc -p tsconfig.types.json",
    "dev": "vite build --watch",
    "pub": "npm run build && npm run test && npm run test:dist && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaemon-technologies/observable.git"
  },
  "keywords": [
    "observable",
    "emitter",
    "watch",
    "emitter",
    "observer",
    "watcher"
  ],
  "author": {
    "name": "MDaemon Technologies, Ltd.",
    "email": "jonathan.ehman@mdaemon.com",
    "url": "https://www.mdaemon.com"
  },
  "license": "LGPL-2.1",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/mdaemon-technologies/observable/issues"
  },
  "homepage": "https://github.com/mdaemon-technologies/observable#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/observable.mjs"
      },
      "require": {
        "types": "./dist/observable.d.cts",
        "default": "./dist/observable.cjs"
      },
      "browser": "./dist/observable.umd.js"
    }
  }
}
